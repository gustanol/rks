CONSOLE_DRIVERS_DIR := drivers/console
CONSOLE_DRIVERS_BUILD_DIR := $(ROOT_BUILD_DIR)/$(CONSOLE_DRIVERS_DIR)

CONSOLE_DRIVERS_C_SOURCES := $(shell find $(CONSOLE_DRIVERS_DIR) -name '*.c')
CONSOLE_DRIVERS_C_OBJECTS := $(patsubst $(CONSOLE_DRIVERS_DIR)/%.c,$(CONSOLE_DRIVERS_BUILD_DIR)/%.o,$(CONSOLE_DRIVERS_C_SOURCES))
CONSOLE_DRIVERS_OBJECTS := $(CONSOLE_DRIVERS_C_OBJECTS)
ALL_OBJECTS += $(CONSOLE_DRIVERS_OBJECTS)

$(CONSOLE_DRIVERS_BUILD_DIR)/%.o: $(CONSOLE_DRIVERS_DIR)/%.c
	@mkdir -p $(dir $@)
	@echo "CC  $<"
	@$(CC) $(CFLAGS) -c $< -o $@
