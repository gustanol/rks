# Toolchain
CC ?= gcc
AS ?= as
LD ?= ld

# Common C flags
CFLAGS := -nostdinc -ffreestanding -fno-builtin -fno-stack-protector
CFLAGS += -Wall -Wextra -Werror -fno-pic -fno-pie
CFLAGS += -mno-red-zone -mcmodel=kernel
CFLAGS += -mno-mmx -mno-sse -mno-sse2

# Defines
CFLAGS += -D__KERNEL__ -DARCH_X64
ALL_OBJECTS :=
ROOT_BUILD_DIR := build

# Include paths
CFLAGS += -I./include
#CFLAGS += -I$(CURDIR)/arch/x64/include

# Assembly flags
ASFLAGS := -g

# Linker flags
LDFLAGS := -T kernel.ld -nostdlib -z max-page-size=0x1000 -no-pie

export CC AS LD CFLAGS ASFLAGS LDFLAGS ALL_OBJECTS ROOT_BUILD_DIR
