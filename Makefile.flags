# Toolchain
CC ?= gcc
AS ?= as
LD ?= ld

# Common C flags
CFLAGS := -nostdinc -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie
CFLAGS += -Wall -Wextra -Werror -Wfatal-errors -Wpedantic -Wstrict-prototypes -Wold-style-definition
CFLAGS += -mno-red-zone -mcmodel=kernel -std=gnu11
CFLAGS += -mno-mmx -mno-sse -mno-sse2 -m64

root_build_dir := build

# Defines
CFLAGS += -D__KERNEL__ -DARCH_X64
obj-0 :=
obj-1 :=
all_objs :=

# Include paths
CFLAGS += -I./include
CFLAGS += -I./arch/$(ARCH)/include

# Assembly flags
ASFLAGS := -g --64

# Linker flags
LDFLAGS := -Wunused-function --warn-common --warn-once
LDFLAGS := -T ./arch/$(ARCH)/boot/kernel.ld -nostdlib -z max-page-size=0x1000 -no-pie -m elf_x86_64

target := rks.elf
autoconfig_header := include/rks/autoconf.h
export CC AS LD CFLAGS ASFLAGS LDFLAGS all_objs root_build_dir
