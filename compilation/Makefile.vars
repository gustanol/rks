# Toolchain
# =========
SHELL := /bin/bash

CC ?= gcc
AS ?= as
LD ?= ld
OBJCOPY ?= objcopy

DEBUG ?= 0

# Architectures
# =============
ARCHS := $(notdir $(wildcard arch/*))
ARCH ?=

# Project directories
# ===================
ARCH_DIR := arch/$(ARCH)
DRIVERS_DIR := drivers
KERNEL_DIR := kernel
LIB_DIR := lib
BUILD_DIR := build

DEBUG_DIR := debug
INCLUDES_DIR := include
ARCH_INCLUDES_DIR := $(ARCH_DIR)/include/$(ARCH)

# Defines
# =======
OBJ-1 :=
OBJ-0 :=

BASE_NAME := rks
ELF_FILE := ./$(BUILD_DIR)/$(BASE_NAME).elf
BIN_NAME := $(BASE_NAME).bin
FINAL_BIN := ./$(BUILD_DIR)/$(BIN_NAME)

# Symbol map gotten from the ELF file
DEBUG_MAP := ./$(DEBUG_DIR)/$(BASE_NAME).debug

CONFIG_BUILD_FLAGS := ./$(COMPILATION_DIR)/CONFIG
CONFIG_HEADER := ./$(INCLUDES_DIR)/rks/autoconf.h
CONFIG_SOURCES_LIST := ./$(BUILD_DIR)/sources.list.mk

# C compiler flags
# ================
CFLAGS := \
	-nostdinc \
	-ffreestanding \
	-fno-builtin \
	-fno-stack-protector \
	-fno-pic \
	-fno-pie \
	-Wall \
	-Wextra \
	-Werror \
	-Wfatal-errors \
	-Wpedantic \
	-Wstrict-prototypes \
	-Wold-style-definition \
	-mno-red-zone \
	-mcmodel=kernel \
	-std=gnu11 \
	-mno-mmx \
	-mno-sse \
	-mno-sse2 \
	-m64 \
	-D__KERNEL__ \
	-DARCH_$(ARCH) \
	-I./$(INCLUDES_DIR)

# Debug flags
ifeq ($(DEBUG),1)
	CFLAGS += \
		-g3 \
		-O0
endif

C_AS_FLAGS := $(CFLAGS) -D__ASSEMBLY__

# Assembler flags
# ===============
ASFLAGS := \
	--fatal-warnings \
	-g \
	--64

# Linker flags
# ============
LDFLAGS := \
	--fatal-warnings \
	--warn-common \
	--warn-once \
	--script=./$(KERNEL_LINKER_SCRIPT) \
	-nostdlib \
	-z max-page-size=0x1000 \
	-no-pie
