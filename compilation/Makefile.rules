all: \
	config_header \
	select_arch \
	cp_arch_includes \
	target

# Config header generator rule
# ==============================================================================
config_header: $(COMPILATION_DIR)/CONFIG
	@echo "/* Generated header. Do not edit this file */" > $(CONFIG_HEADER)
	@echo "#ifndef AUTOCONF_H" >> $(CONFIG_HEADER)
	@echo "#define AUTOCONF_H" >> $(CONFIG_HEADER)
	@$(foreach v, $(filter CFG_%, $(.VARIABLES)), \
		echo "#define $(v) $($(v))" >> $(CONFIG_HEADER);)
	@echo "#endif /* AUTOCONF_H */" >> $(CONFIG_HEADER)
	@echo "Configuration header -> $(CONFIG_HEADER)" 

select_arch:
ifndef ARCH
	$(eval ARCH := $(shell \
		echo "Architecture not set. Select one the following:" >&2; \
		select arch in $(ARCHS); do \
			echo $$arch; \
			break; \
		done \
	))
endif

ifeq ($(filter $(ARCH),$(ARCHS)),)
	$(error Invalid ARCH '$(ARCH)'. Available: $(ARCHS))
endif

# Target build rule
# =================================================================
ifeq ($(DEBUG),1)
POST_LINK = \
	mkdir -p $(DEBUG_DIR); \
	$(OBJCOPY) --only-keep-debug $(ELF_FILE) $(DEBUG_MAP); \
	$(OBJCOPY) --strip-all $(ELF_FILE) $(FINAL_BIN); \
	$(OBJCOPY) --add-gnu-debuglink=$(DEBUG_MAP) $(FINAL_BIN); \
	echo "Debug symbols -> $(DEBUG_MAP)";
else
POST_LINK = \
	$(OBJCOPY) --strip-all $(ELF_FILE) $(FINAL_BIN);
endif

# Target binary rule
target: $(OBJ-1)
	@$(LD) $(LDFLAGS) $^ -o $(ELF_FILE)
	@echo "LD -> $(ELF_FILE)"

	@$(POST_LINK)
	@echo "Stripped binary -> $(FINAL_BIN)"

	@rm -f $(ELF_FILE)
	@echo "RM -> $(ELF_FILE)"

	@ln -sf $(FINAL_BIN) .
	@echo "LN [SYMLINK] -> ./$(BIN_NAME)"
# =================================================================

# Debug building only
debug: $(OBJ-1)
	@$(LD) $(LDFLAGS) $^ -o $(TARGET)
	@echo "LD [DEBUG] -> $(TARGET)"

# Arch includes copying rule
cp_arch_includes: clean_arch_includes
	@cp -pr $(ARCH_INCLUDES_DIR) $(INCLUDES_DIR)/arch
	@echo "CP -> $(ARCH_INCLUDES_DIR) => $(INCLUDES_DIR)/arch"

# Build rules
# =====================================
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)

	@$(CC) \
		$(CFLAGS) \
		-c $< \
		-o $@

	@echo "CC -> $@"

$(BUILD_DIR)/%.o: %.S
	@mkdir -p $(dir $@)

	@$(CC) \
		$(C_AS_FLAGS) \
		-c $< \
		-o $@

	@echo "CC (S) -> $@"
# ======================================

# Cleaning
# ==========================================
clean: clean_arch_includes
	@rm -rf ./$(BUILD_DIR)
	@echo "RM -> ./$(BUILD_DIR)"

	@rm -f $(CONFIG_HEADER)
	@echo "RM -> $(CONFIG_HEADER)"

	@rm -f ./$(BIN_NAME)
	@echo "RM -> ./$(BIN_NAME)"

	@rm -rf ./$(DEBUG_DIR)
	@echo "RM -> ./$(DEBUB_DIR)"

clean_arch:
	@rm -rf $(ARCH_BUILD_DIR)
	@echo "RM -> $(ARCH_BUILD_DIR)"

clean_drivers:
	@rm -rf ./$(DRIVERS_BUILD_DIR)
	@echo "RM -> $(DRIVERS_BUILD_DIR)"

clean_kernel:
	@rm -rf $(KERNEL_BUILD_DIR)
	@echo "RM -> $(KERNEL_BUILD_DIR)"

clean_lib:
	@rm -rf $(LIB_BUILD_DIR)
	@echo "RM -> $(LIB_BUILD_DIR)"

clean_arch_includes:
	@rm -rf ./$(INCLUDES_DIR)/arch
	@echo "RM -> ./$(INCLUDES_DIR)/arch"
# ==========================================

.PHONY: \
	all \
	target \
	config_header \
	archs \
	clean \
	help
