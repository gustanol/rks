# Main build rule
# ===============
all: \
	check_arch \
	config_header \
	cp_arch_includes \
	target
# ===============

check_arch:
ifndef ARCH
	$(error Run 'make reconfigure' first)
endif

# Config header generator rule
# ============================
config_header: $(COMPILE_FLAGS)
	@echo "/* Generated header. Do not edit this file */" > $(CONFIG_HEADER)
	@echo "#ifndef AUTOCONF_H" >> $(CONFIG_HEADER)
	@echo "#define AUTOCONF_H" >> $(CONFIG_HEADER)
	@$(foreach v, $(filter COMPILE_%, $(.VARIABLES)), \
		echo "#define $(v) $($(v))" >> $(CONFIG_HEADER);)
	@echo "#endif /* AUTOCONF_H */" >> $(CONFIG_HEADER)
	@echo "Configuration header -> $(CONFIG_HEADER)" 
# ============================

# Arch includes copying rule
# ==========================
cp_arch_includes:
	@cp -pr $(ARCH_INCLUDES_DIR) $(ARCH_GENERIC_INCLUDES)
	@echo "$(ARCH) global includes -> $(ARCH_GENERIC_INCLUDES)"
# ==========================

# Special debug treatment after linking
# =====================================
ifeq ($(DEBUG),1)

# Keeps the symbol map aside the final binary
POST_LINK = \
	mkdir -p $(DEBUG_DIR); \

	$(OBJCOPY) --only-keep-debug $(ELF_FILE) $(DEBUG_MAP); \
	$(OBJCOPY) --strip-all $(ELF_FILE) $(FINAL_BIN); \
	$(OBJCOPY) --add-gnu-debuglink=$(DEBUG_MAP) $(FINAL_BIN); \

	echo "Debug symbols -> $(DEBUG_MAP)";

else

# No debug treating at all
POST_LINK = \
	$(OBJCOPY) --strip-all $(ELF_FILE) $(FINAL_BIN);

endif
# =====================================

# Target binary rule
# ==================
target: $(OBJ-1)
	@$(LD) $(LDFLAGS) $^ -o $(ELF_FILE)
	@echo "LD -> $(ELF_FILE)"

	@$(POST_LINK)
	@echo "Stripped binary -> $(FINAL_BIN)"

	@rm -f $(ELF_FILE)
	@echo "RM -> $(ELF_FILE)"

	@ln -sf $(FINAL_BIN) .
	@echo "LN [SYMLINK] -> ./$(BIN_NAME)"

# Debug building only
# ===================
debug: $(OBJ-1)
	@$(LD) $(LDFLAGS) $^ -o $(TARGET)
	@echo "LD [DEBUG] -> $(TARGET)"
# ===================

# C build rule
# ============
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)

	@$(CC) \
		$(CFLAGS) \
		-c $< \
		-o $@

	@echo "CC -> $@"
# ============

# GAS build rule
# ==============
$(BUILD_DIR)/%.o: %.S
	@mkdir -p $(dir $@)

	@$(CC) \
		$(CFLAGS) \
		$(GAS_CFLAGS) \
		-c $< \
		-o $@

	@echo "CC (GAS) -> $@"
# ==============

.PHONY: \
	all \
	config_headers \
	cp_arch_includes \
	target \
	debug
