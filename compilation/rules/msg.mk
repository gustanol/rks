# Helping
# =======
help:
	@echo "Research Kernel System"
	@echo ""
	@echo "Commands:"
	@echo "  { Building }"
	@echo "    [ make, make all ]"
	@echo "      Generates the configuration header with all flags defined at ./config.mk and triggers the rules to build all selected objects."
	@echo "    OPTIONS"
	@echo "      - ARCH=<ARCH_NAME>: Target architecture ('make archs' to view all available architectures)."
	@echo ""
	@echo "    [ make target ]"
	@echo "      Links the final binary and create a symlink at project root. Only useful if all objects were already built. Commonly, you will not need to use it directly."
	@echo ""
	@echo "    [ make config_header ]"
	@echo "      Generates the configuration header containing all updated flags defined at ./config.mk. Useful if you don't want to rebuild everything just to update the header content."
	@echo ""
	@echo "  { Cleaning }"
	@echo "    [ make clean ]"
	@echo "      Cleans all content within the build directory (objects and final binary), the generated header and the symlink at project root. Use it with caution."
	@echo ""
	@echo "    [ make clean_arch ]"
	@echo "      Cleans only architecture build artifacts."
	@echo ""
	@echo "    [ make clean_drivers ]"
	@echo "      Cleans only drivers build artifacts."
	@echo ""
	@echo "    [ make clean_kernel ]"
	@echo "      Cleans only kernel build artifacts. It refers to generic kernel code."
	@echo ""
	@echo "    [ make clean_lib ]"
	@echo "      Cleans only library build artifacts."
	@echo ""
	@echo "  { Others }"
	@echo "    [ make help ]"
	@echo "      Shows this message as a help."

.PHONY: help
