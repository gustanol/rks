X86_PAGING_BACKEND_SRC_DIR := $(ARCH_DIR)/mem/vmm/paging
X86_PAGING_BACKEND_BUILD_DIR := $(BUILD_DIR)/$(X86_PAGING_BACKEND_SRC_DIR)

# Core objects
OBJ-1 += \
	$(X86_PAGING_BACKEND_BUILD_DIR)/early_map.o \
	$(X86_PAGING_BACKEND_BUILD_DIR)/init.o \
	$(X86_PAGING_BACKEND_BUILD_DIR)/page.o \
	$(X86_PAGING_BACKEND_BUILD_DIR)/space.o

# Mappings
OBJ-1 += \
	$(X86_PAGING_BACKEND_BUILD_DIR)/mappings/kernel_hh.o \
	$(X86_PAGING_BACKEND_BUILD_DIR)/mappings/kernel_higher_half.o

# Paging CFLAGS
X86_PAGING_BACKEND_CFLAGS := \
	-I$(X86_PAGING_BACKEND_SRC_DIR)/include

# Scope flags
$(X86_PAGING_BACKEND_BUILD_DIR)/$.o: \
	CFLAGS += $(X86_PAGING_BACKEND_CFLAGS)
