# Toolchain {
CC ?= gcc
AS ?= as
LD ?= ld
# }

# Architectures {
 ARCH ?= x86_64
 ARCHS := \
	x86_64

 # Validate the chosen architecture
 ifeq ($(filter $(ARCH),$(ARCHS)),)
     $(error Unsupported architecture: $(ARCH). Run make archs)
 endif
# }

# Project directories {
ARCH_DIR := arch/$(ARCH)
DRIVERS_DIR := drivers
KERNEL_DIR := kernel
LIB_DIR := lib
INCLUDES_DIR := include
# }

# C compiler flags {
CFLAGS := \
	-nostdinc \
	-ffreestanding \
	-fno-builtin \
	-fno-stack-protector \
	-fno-pic \
	-fno-pie \
	-Wall \
	-Wextra \
	-Werror \
	-Wfatal-errors \
	-Wpedantic \
	-Wstrict-prototypes \
	-Wold-style-definition \
	-mno-red-zone \
	-mcmodel=kernel \
	-std=gnu11 \
	-mno-mmx \
	-mno-sse \
	-mno-sse2 \
	-m64 \
	-D__KERNEL__ \
	-D$(ARCH) \
	-I./$(INCLUDES_DIR) \
	-I./arch/$(ARCH)/include
# }

# Assembler flags {
ASFLAGS := \
	--fatal-warnings \
	-g \
	--64
# }

# Linker flags {
LDFLAGS := \
	--fatal-warnings \
	--warn-common \
	--warn-once \
	--script=./arch/$(ARCH)/boot/kernel.ld \
	-nostdlib \
	-z max-page-size=0x1000 \
	-no-pie
# }

# Build directories {
BUILD_DIR := build
ARCH_BUILD_DIR := ./$(BUILD_DIR)/$(ARCH_DIR)
DRIVERS_BUILD_DIR := ./$(BUILD_DIR)/$(DRIVERS_DIR)
KERNEL_BUILD_DIR := ./$(BUILD_DIR)/$(KERNEL_DIR)
LIB_BUILD_DIR := ./$(BUILD_DIR)/$(LIB_DIR)
# }

# Defines {
OBJ-1 :=
OBJS :=
BIN_NAME := rks
TARGET := ./$(BUILD_DIR)/$(BIN_NAME)
CONFIG_HEADER := ./$(INCLUDES_DIR)/rks/autoconf.h
# }

# Include all Makefiles right here {
include config.mk
-include arch/$(ARCH)/Makefile
include drivers/Makefile
include kernel/Makefile
include lib/Makefile
# }

# All objects
OBJS := $(OBJ-1)

# Main rule
all: config_header target

# Cleaning {
clean:
	rm -rf $(BUILD_DIR)
	rm -f include/rks/autoconf.h
	rm -f ./$(BIN_NAME)

clean_arch:
	rm -rf $(ARCH_BUILD_DIR)

clean_drivers:
	rm -rf $(DRIVERS_BUILD_DIR)

clean_kernel:
	rm -rf $(KERNEL_BUILD_DIR)

clean_lib:
	rm -rf $(LIB_BUILD_DIR)
# }

# Target build rule {
target: $(OBJS)
	@$(LD) $(LDFLAGS) $^ -o $(TARGET)
	@echo "LD -> $(TARGET)"
	@ln -sf $(TARGET) .
	@echo "Binary symlink: ./$(BIN_NAME)"
# }

# Generate a header with all flags {
config_header: config.mk
	@echo "/* Generated header. Do not edit this file */" > $(CONFIG_HEADER)
	@echo "#ifndef AUTOCONF_H" >> $(CONFIG_HEADER)
	@echo "#define AUTOCONF_H" >> $(CONFIG_HEADER)
	@echo "/* SOM */" >> $(CONFIG_HEADER)
	@$(foreach v, $(filter CFG_%, $(.VARIABLES)), \
		echo "#define $(v) $($(v))" >> $(CONFIG_HEADER);)
	@echo "/* EOM */" >> $(CONFIG_HEADER)
	@echo "#endif /* AUTOCONF_H */" >> $(CONFIG_HEADER)
	@echo "Configuration header: $(CONFIG_HEADER)" 
# }

# List all available architectues {
archs:
	@echo "Available architectures:"
	@$(foreach v, $(ARCHS), \
		echo "  - $(v)")
# }

# C building rules {
$(ARCH_BUILD_DIR)/%.o: $(ARCH_DIR)/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@
	@echo "CC [$(ARCH)] -> $@"

$(DRIVERS_BUILD_DIR)/%.o: $(DRIVERS_DIR)/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@
	@echo "CC [DRIVER] -> $@"

$(KERNEL_BUILD_DIR)/%.o: $(KERNEL_DIR)/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@
	@echo "CC [KERNEL] -> $@"

$(LIB_BUILD_DIR)/%.o: $(LIB_DIR)/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@
	@echo "CC [LIBRARY] -> $@"
# }

# Assembly assembling rules {
$(ARCH_BUILD_DIR)/%.o: $(ARCH_DIR)/%.S
	@mkdir -p $(dir $@)
	@$(AS) $(ASFLAGS) $< -o $@
	@echo "AS [$(ARCH)] -> $@"
# }

help:
	@echo "Research Kernel System"
	@echo ""
	@echo "Commands:"
	@echo "  {Building}"
	@echo "    [ make, make all ]"
	@echo "      Generate the configuration header with all flags defined at ./config.mk and trigger the rules to build all selected objects."
	@echo "    OPTIONS"
	@echo "      - ARCH=arch_name: Target architecture [make archs to view all available]"
	@echo ""
	@echo "    [ make target ]"
	@echo "      Link the final binary and create a symlink at project root. Only useful if all objects were already built. Commonly, you will not need to use it directly."
	@echo ""
	@echo "    [ make config_header ]"
	@echo "      Only generate the configuration header will all updated flags defined at ./config.mk. Useful with you don't want to rebuild everything just to update the header."
	@echo ""
	@echo "  {Cleaning}"
	@echo "    [ make clean ]"
	@echo "      Clean ALL build directory (objects, final binary), the generated header and the symlink at project root. Use it with caution."
	@echo ""
	@echo "    [ make clean_arch ]"
	@echo "      Clean only architecture build artifacts."
	@echo ""
	@echo "    [ make clean_drivers ]"
	@echo "      Clean only drivers build artifacts."
	@echo ""
	@echo "    [ make clean_kernel ]"
	@echo "      Clean only kernel build artifacts. It refers to generic kernel code."
	@echo ""
	@echo "    [ make clean_lib ]"
	@echo "      Clean only library build artifacts."
	@echo ""
	@echo "  {Others}"
	@echo "    [ make help ]"
	@echo "      Show this message as a help."

.PHONY: \
	all \
	target \
	config_header \
	archs \
	clean \
	help
